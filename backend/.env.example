# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# For production/Docker: postgresql://doboku_user:doboku_pass@localhost:5432/dobokutracker
# Leave empty or set to 'memory' to use embedded PGlite for rapid tests/dev without Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dobokutracker

# Supabase Auth & Storage Integration (Tokyo region ap-northeast-1)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-backend-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Photo Storage Configuration
# Options: 'local' (development/testing) or 'supabase' (production private bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads/photos
STORAGE_BUCKET_NAME=project-photos

# Demo & Safety Policy
# Demo mode with synthetic data is strictly prohibited in production (NODE_ENV=production)
DEMO_MODE_ALLOWED=true
